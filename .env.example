# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/ev_charger
DB_USERNAME=ocpp_app
DB_PASSWORD=changeme
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# --- Server ---
SERVER_PORT=9093
SPRING_PROFILES_ACTIVE=dev

# --- JWT (admin REST API auth) ---
# Generate a random 256-bit+ secret, e.g.: openssl rand -hex 64
JWT_SECRET=changeme-generate-with-openssl-rand-hex-64
JWT_EXPIRATION_MS=3600000

# --- Admin account (single operator account for the REST API) ---
ADMIN_USERNAME=admin
# BCrypt hash of the admin password - never store the plaintext password anywhere.
# Generate with either of:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=changeme-bcrypt-hash

# --- CORS (comma-separated origins allowed to call the REST API from a browser; leave empty to disable) ---
ALLOWED_ORIGINS=

# --- Charge point WebSocket auth ---
# Each pre-registered charger gets its own password via POST /api/chargers (see README).
# Chargers authenticate to the OCPP WebSocket with HTTP Basic Auth: chargeBoxId:password.
